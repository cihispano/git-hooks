<?xml version="1.0" encoding="UTF-8"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="CiHispano Coding Standard"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <description>The coding standard for the CiHispano Git Hooks library.</description>

    <arg name="colors"/>
    <arg value="ps"/>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/writable/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!--
        Ownership split:
        - PHP CS Fixer (CodeIgniter coding standard) owns every mechanically fixable rule:
          imports, phpdoc formatting, operator spacing, list<> types, strict_types... Run
          `composer cs:fix` for those.
        - PHP_CodeSniffer (PSR12 + the curated Slevomat sniffs below) only OWNS rules that
          require a human decision or cannot be auto-fixed.
    -->
    <rule ref="SlevomatCodingStandard.Arrays.DisallowImplicitArrayCreation"/>
    <rule ref="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion"/>
    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <properties>
            <property name="rootNamespaces" type="array">
                <element key="src" value="CiHispano"/>
                <element key="tests" value="CiHispano\Tests"/>
            </property>
        </properties>
    </rule>

    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Generic.Formatting.SpaceBeforeCast"/>

    <phpini name="memory_limit" value="512M"/>
</ruleset>
