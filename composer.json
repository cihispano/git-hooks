{
    "name": "cihispano/git-hooks",
    "description": "Automated Git Hooks for CodeIgniter 4 projects with PHPStan, PHP CS Fixer, and quality checks",
    "type": "library",
    "keywords": [
        "code-quality",
        "codeigniter",
        "codeigniter4",
        "commit-msg",
        "git-hooks",
        "php-cs-fixer",
        "phpcs",
        "phpstan",
        "pre-commit",
        "pre-push",
        "static-analysis"
    ],
    "homepage": "https://github.com/cihispano/git-hooks",
    "license": "MIT",
    "authors": [
        {
            "name": "Jorge Armando Pacheco Del real",
            "email": "jarmandopache@gmail.com",
            "homepage": "https://gitlab.com/cihispano.org",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cihispano/git-hooks/issues",
        "source": "https://github.com/cihispano/git-hooks",
        "docs": "https://github.com/cihispano/git-hooks#readme"
    },
    "require": {
        "php": "^8.4",
        "nunomaduro/termwind": "^2.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CiHispano\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CiHispano\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "install-hooks": "CiHispano\\ComposerScripts::install",
        "uninstall-hooks": "CiHispano\\ComposerScripts::uninstall",
        "analyze": "@php -d xdebug.mode=off -d xdebug.log= vendor/bin/phpstan analyze --verbose",
        "check:all": [
            "@analyze",
            "@sniff",
            "@cs",
            "@test"
        ],
        "cs": "@php -d xdebug.mode=off -d xdebug.log= vendor/bin/php-cs-fixer fix --ansi --verbose --dry-run --diff",
        "cs:fix": "@php -d xdebug.mode=off -d xdebug.log= vendor/bin/php-cs-fixer fix --ansi --verbose --diff",
        "clear:cache": [
            "@php -r \"if (file_exists('build/.php-cs-fixer.cache')) unlink('build/.php-cs-fixer.cache');\"",
            "@php -r \"if (file_exists('build/phpstan.cache')) unlink('build/phpstan.cache');\"",
            "@php -r \"echo 'Cache cleared successfully' . PHP_EOL;\""
        ],
        "sniff": "@php -d xdebug.mode=off -d xdebug.log= vendor/bin/phpcs",
        "sniff:fix": "@php -d xdebug.mode=off -d xdebug.log= vendor/bin/phpcbf",
        "style": "@cs:fix",
        "test": "@php -d xdebug.mode=off -d xdebug.log= vendor/bin/phpunit --configuration phpunit.xml.dist --colors=always",
        "test:coverage": "@php -d xdebug.mode=coverage -d xdebug.start_with_request=yes vendor/bin/phpunit --configuration phpunit.xml.dist --colors=always --coverage-text --coverage-html build/coverage"
    },
    "scripts-descriptions": {
        "analyze": "Run static analysis with PHPStan to find potential bugs.",
        "check:all": "Run all quality checks: PHPStan, PHPCS, and PHP-CS-Fixer.",
        "cs": "Check code style using PHP-CS-Fixer without applying changes.",
        "cs:fix": "Fix code style issues automatically using PHP-CS-Fixer.",
        "clear:cache": "Remove cache files generated by the QA tools.",
        "install-hooks": "Install Git hooks into the current repository.",
        "sniff": "Check code style and PSR-12 compliance with PHP_CodeSniffer.",
        "sniff:fix": "Automatically fix PHP_CodeSniffer style violations.",
        "style": "Alias for the cs:fix command.",
        "test": "Run the automated test suite with PHPUnit.",
        "test:coverage": "Run PHPUnit with coverage and generate an HTML coverage report.",
        "uninstall-hooks": "Remove Git hooks from the current repository."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
