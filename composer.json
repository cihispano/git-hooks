{
    "name": "cihispano/git-hooks",
    "description": "Automated Git Hooks for CodeIgniter 4 projects with PHPStan, PHP CS Fixer, and quality checks",
    "type": "library",
    "keywords": [
        "codeigniter",
        "codeigniter4",
        "git-hooks",
        "pre-commit",
        "pre-push",
        "commit-msg ",
        "phpstan",
        "php-cs-fixer",
        "code-quality",
        "static-analysis"
    ],
    "homepage": "https://github.com/cihispano/git-hooks",
    "license": "MIT",
    "authors": [
        {
            "name": "Jorge Armando Pacheco Del real",
            "email": "jarmandopache@gmail.com",
            "homepage": "https://gitlab.com/cihispano.org",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cihispano/git-hooks/issues",
        "source": "https://github.com/cihispano/git-hooks",
        "docs": "https://github.com/cihispano/git-hooks#readme"
    },
    "require": {
        "php": "^8.1",
        "nunomaduro/termwind": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "phpstan/phpstan": "^1.10|^2.0",
        "friendsofphp/php-cs-fixer": "^3.40"
    },
    "autoload": {
        "psr-4": {
            "CiHispano\\GitHooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CiHispano\\GitHooks\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "phpstan analyze --verbose",
        "test": "phpunit tests --testdox",
        "test-coverage": "phpunit --coverage-html coverage",
        "cs": "php-cs-fixer fix --ansi --verbose --dry-run --diff",
        "cs-fix": "php-cs-fixer fix --ansi --verbose --diff",
        "style": "@cs-fix"
    },
    "scripts-descriptions": {
        "analyze": "Analyses source code",
        "test": "Run unit tests",
        "test-coverage": "Run tests with coverage report",
        "cs": "Check code style",
        "cs-fix": "Fix code style issues",
        "style": "cs-fix alias"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}