#!/bin/sh

# ══════════════════════════════════════════════════════════════════════════
# Copyright (c) 2026.
# This file is part of CiHispano Git Hooks library.
#
# @copyright CiHispano <administracion@cihispano.org>
# @license For the full copyright and license information, see the LICENSE file distributed with this source code.
# ══════════════════════════════════════════════════════════════════════════

# 1. Access the commit message
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
FIRST_LINE=$(printf '%s\n' "$COMMIT_MSG" | sed -n '1p')

# 2. Define Regex and Constants (Conventional Commits v1.0.0)
REG_CONVENTIONAL="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?!?: .{1,}"
MIN_LENGTH=10
MAX_LENGTH=100

printf '\n'
printf '\033[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'
printf '\033[1;36m   CiHispano: Validating Commit Message Style             \033[0m\n'
printf '\033[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'

# ══════════════════════════════════════════════════════════════════════════
# 1. LENGTH VALIDATIONS
# ══════════════════════════════════════════════════════════════════════════
MSG_LENGTH=${#FIRST_LINE}

if [ "$MSG_LENGTH" -lt "$MIN_LENGTH" ]; then
    printf '\033[0;31m✘ Message is too short (%s/%s chars min)\033[0m\n' "$MSG_LENGTH" "$MIN_LENGTH"
    exit 1
fi

if [ "$MSG_LENGTH" -gt "$MAX_LENGTH" ]; then
    printf '\033[0;31m✘ Message is too long (%s/%s chars max)\033[0m\n' "$MSG_LENGTH" "$MAX_LENGTH"
    exit 1
fi

# ══════════════════════════════════════════════════════════════════════════
# 2. CONVENTIONAL COMMITS FORMAT CHECK
# ══════════════════════════════════════════════════════════════════════════
if ! printf '%s\n' "$FIRST_LINE" | grep -qE "$REG_CONVENTIONAL"; then
    printf '\033[0;31m✘ Invalid format.\033[0m\n'
    printf '\n'
    printf '\033[1;33mExpected Format:\033[0m\n'
    printf '    type(scope): description\n'
    printf '\n'
    printf '\033[1;33mAllowed Types:\033[0m\n'
    printf '    feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert\n'
    printf '\n'
    printf '\033[1;33mExample:\033[0m\n'
    printf '    feat(auth): add email verification\n'
    printf '\n'
    printf '\033[0;37mRef: https://www.conventionalcommits.org/\033[0m\n'
    exit 1
fi

# ══════════════════════════════════════════════════════════════════════════
# 3. SUCCESS MESSAGE
# ══════════════════════════════════════════════════════════════════════════
printf '\033[0;32m✔ Commit message format is valid\033[0m\n'
printf '\n'
exit 0
