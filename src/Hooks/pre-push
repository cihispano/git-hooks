#!/bin/sh

# ══════════════════════════════════════════════════════════════════════════
# Copyright (c) 2026.
# This file is part of CiHispano Git Hooks library.
#
# @copyright CiHispano <administracion@cihispano.org>
# @license For the full copyright and license information, see the LICENSE file distributed with this source code.
# ══════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════
# 1. ENVIRONMENT SETUP
# ══════════════════════════════════════════════════════════════════════════

# Determine the project root.
#
# Git runs hooks from the repository root, so `git rev-parse --show-toplevel`
# is authoritative and also honors `core.hooksPath`, worktrees and submodules
# (the hook file may live outside the default `.git/hooks`).
# The fallback resolves from the hook path (hooks dir -> .git -> root) and is
# never interpolated into PHP code, so checkout paths containing quotes or
# metacharacters are safe.
if command -v git >/dev/null 2>&1 \
    && PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) \
    && [ -n "$PROJECT_ROOT" ]; then
    :
else
    HOOK_DIR=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd) || exit 1
    PROJECT_ROOT=$(dirname -- "$(dirname -- "$HOOK_DIR")")
fi
VENDOR_BIN="$PROJECT_ROOT/vendor/bin"
PACKAGE_CONFIG="$PROJECT_ROOT/vendor/cihispano/git-hooks"
export XDEBUG_MODE=off
# The `-d` flags are written inline on every `php` call: keeping them in a
# variable would depend on word-splitting, which breaks as soon as IFS is
# narrowed anywhere in this script.

printf '\n'
printf '\033[0;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'
printf '\033[1;35m   CiHispano: Final Integrity Checks before Push          \033[0m\n'
printf '\033[0;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'

# Switch to project root
cd "$PROJECT_ROOT" || exit 1

# ══════════════════════════════════════════════════════════════════════════
# 1. PHPUNIT (Logic & Regression Tests)
# ══════════════════════════════════════════════════════════════════════════
if [ -f "$VENDOR_BIN/phpunit" ]; then
    printf '\033[1;34m  [1/2] Running Unit Tests (PHPUnit)...\033[0m\n'

    # Priority: Project root phpunit.xml > phpunit.xml.dist > Package central config
    PHPUNIT_CONFIG="phpunit.xml"
    [ ! -f "$PHPUNIT_CONFIG" ] && PHPUNIT_CONFIG="phpunit.xml.dist"
    [ ! -f "$PHPUNIT_CONFIG" ] && PHPUNIT_CONFIG="$PACKAGE_CONFIG/phpunit.xml.dist"

    if ! php -d xdebug.mode=off -d xdebug.log= "$VENDOR_BIN/phpunit" -c "$PHPUNIT_CONFIG" --no-coverage --stop-on-failure; then
        printf '\n\033[0;31m✘ Tests failed! Please fix your code before pushing.\033[0m\n\n'
        exit 1
    fi
    printf '\033[0;32m✔ All tests passed\033[0m\n'
else
    printf '\033[0;33m⚠ PHPUnit not found. Skipping logic tests...\033[0m\n'
fi

# ══════════════════════════════════════════════════════════════════════════
# 2. FULL PROJECT ANALYSIS (PHPStan)
# ══════════════════════════════════════════════════════════════════════════
if [ -f "$VENDOR_BIN/phpstan" ]; then
    printf '\n\033[1;34m  [2/2] Running Full Static Analysis (PHPStan)...\033[0m\n'

    # Priority: Project root phpstan.neon > phpstan.neon.dist > Package central config
    STAN_CONFIG="phpstan.neon"
    [ ! -f "$STAN_CONFIG" ] && STAN_CONFIG="phpstan.neon.dist"
    [ ! -f "$STAN_CONFIG" ] && STAN_CONFIG="$PACKAGE_CONFIG/phpstan.neon.dist"

    # We analyze the whole project on push to ensure global consistency
    if ! php -d xdebug.mode=off -d xdebug.log= "$VENDOR_BIN/phpstan" analyse -c "$STAN_CONFIG" --no-progress --ansi; then
        printf '\n\033[0;31m✘ PHPStan found global issues. Fix them before pushing.\033[0m\n\n'
        exit 1
    fi
    printf '\033[0;32m✔ Full analysis completed successfully\033[0m\n'
fi

printf '\n'
printf '\033[0;32m  ✔ Integrity verified. Ready to push. \033[0m\n'
printf '\n'
exit 0
