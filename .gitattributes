# Distribution artifact (Composer `dist`/`git archive`): keep only runtime
# files. Development-only content is excluded from the published package.
/tests/                 export-ignore
/docs/                  export-ignore
/scripts/               export-ignore
/.github/               export-ignore
/.gitlab/               export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.gitlab-ci.yml         export-ignore
/.editorconfig          export-ignore
/CLAUDE.md              export-ignore
/CONTRIBUTING.md        export-ignore
/CODE_OF_CONDUCT.md     export-ignore
/composer.lock          export-ignore

# Keep the QA default configs: the distributed hooks fall back to these
# under `vendor/cihispano/git-hooks/` when a consumer has no own config.
# (phpcs.xml.dist, phpstan.neon.dist, phpunit.xml.dist, .php-cs-fixer.dist.php)
